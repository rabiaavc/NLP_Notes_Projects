     "end_time": "2026-02-27T06:53:38.143893Z",
     "start_time": "2026-02-27T06:53:35.121180Z"
    }
   },
   "cell_type": "code",
   "source": [
    "result = Test(5).add(3).multiply(2)\n",
    "print(result.value)"
   ],
