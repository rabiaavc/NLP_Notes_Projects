   "cell_type": "code",
   "source": [
    "class Test:\n",
    "    def __init__(self, value):\n",
    "        self.value = value\n",
    "\n",
    "    def add(self, x):\n",
    "        self.value += x\n",
    "        return self\n",
    "\n",
    "    def multiply(self, x):\n",
    "        self.value *= x\n",
    "        return self"
   ],
   "id": "d8bb768acf1b15f4",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {
